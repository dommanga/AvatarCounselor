{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/prompts.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/session/*.js": {
      "maxDuration": 60
    }
  }
}
