# Set in Vercel project settings (Environment Variables), never commit the real values.
OPENAI_API_KEY=sk-...
# Password for /researcher (also signs the researcher cookie — changing it logs everyone out).
RESEARCHER_PASSWORD=...
# Secret of the external management API (header X-Admin-Secret); unset = the API is off. Separate from RESEARCHER_PASSWORD.
ADMIN_API_SECRET=...
# Injected by the Vercel Neon integration; locally via `vercel env pull .env.local`.
DATABASE_URL=postgres://...
